{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Reads OrcaSlicer's data folder ($CONFIG/OrcaSlicer). Writes only user presets ($CONFIG/OrcaSlicer/user), the app's own backups ($APPDATA/backups), and its preferences ($APPDATA/settings.json); never system presets. Removes only its own temporary files (*.tmp). Can close its window without asking again (after the UI asked about unsaved changes).",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    {
      "identifier": "fs:allow-exists",
      "allow": [
        {
          "path": "$CONFIG/OrcaSlicer"
        },
        {
          "path": "$CONFIG/OrcaSlicer/**"
        },
        {
          "path": "$APPDATA/settings.json"
        }
      ]
    },
    {
      "identifier": "fs:allow-read-dir",
      "allow": [
        {
          "path": "$CONFIG/OrcaSlicer"
        },
        {
          "path": "$CONFIG/OrcaSlicer/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [
        {
          "path": "$CONFIG/OrcaSlicer/**"
        },
        {
          "path": "$APPDATA/settings.json"
        }
      ]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [
        {
          "path": "$CONFIG/OrcaSlicer/user/**"
        },
        {
          "path": "$APPDATA/backups/**"
        },
        {
          "path": "$APPDATA/settings.json"
        }
      ]
    },
    {
      "identifier": "fs:allow-rename",
      "allow": [
        {
          "path": "$CONFIG/OrcaSlicer/user/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-remove",
      "allow": [
        {
          "path": "$CONFIG/OrcaSlicer/user/**/*.tmp"
        }
      ]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [
        {
          "path": "$APPDATA"
        },
        {
          "path": "$APPDATA/backups"
        },
        {
          "path": "$APPDATA/backups/**"
        }
      ]
    }
  ]
}
